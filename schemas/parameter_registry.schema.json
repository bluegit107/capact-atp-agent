{
  "$defs": {
    "ParamChange": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "minimum": 2,
          "title": "Version",
          "type": "integer"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "before": {
          "title": "Before",
          "type": "number"
        },
        "after": {
          "title": "After",
          "type": "number"
        },
        "actor": {
          "title": "Actor",
          "type": "string"
        },
        "actor_role": {
          "$ref": "#/$defs/Role"
        },
        "actor_kind": {
          "const": "human",
          "title": "Actor Kind",
          "type": "string"
        },
        "reason": {
          "minLength": 5,
          "title": "Reason",
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "from_proposal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Proposal"
        }
      },
      "required": [
        "version",
        "key",
        "before",
        "after",
        "actor",
        "actor_role",
        "actor_kind",
        "reason",
        "at"
      ],
      "title": "ParamChange",
      "type": "object"
    },
    "ParamSpec": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "min_value": {
          "title": "Min Value",
          "type": "number"
        },
        "max_value": {
          "title": "Max Value",
          "type": "number"
        },
        "integer": {
          "default": false,
          "title": "Integer",
          "type": "boolean"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "editable_by": {
          "items": {
            "$ref": "#/$defs/Role"
          },
          "minItems": 1,
          "title": "Editable By",
          "type": "array"
        },
        "checkpoint": {
          "enum": [
            "CP1",
            "CP2",
            "CP3",
            "CP4",
            "CP5",
            "CP6",
            "CP7"
          ],
          "title": "Checkpoint",
          "type": "string"
        },
        "basis": {
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "key",
        "label",
        "unit",
        "value",
        "min_value",
        "max_value",
        "provenance",
        "editable_by",
        "checkpoint",
        "basis"
      ],
      "title": "ParamSpec",
      "type": "object"
    },
    "Provenance": {
      "description": "정보 성격 구분 (A05 §6: 원본·부서 주장·가정·합성·모의·계산결과를 섞지 않는다).",
      "enum": [
        "SOURCE",
        "DEPT_CLAIM",
        "ASSUMPTION",
        "SYNTHETIC",
        "SIMULATED",
        "HUMAN_INPUT",
        "DERIVED"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "Role": {
      "description": "RBAC 역할 (approval_authority_policy.md 의 승인 주체와 정렬).",
      "enum": [
        "영업",
        "생산",
        "구매",
        "품질",
        "재무",
        "영업임원",
        "CEO/이사회",
        "심사자",
        "정책관리자"
      ],
      "title": "Role",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "specs": {
      "items": {
        "$ref": "#/$defs/ParamSpec"
      },
      "title": "Specs",
      "type": "array"
    },
    "history": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ParamChange"
      },
      "title": "History",
      "type": "array"
    }
  },
  "required": [
    "version",
    "specs"
  ],
  "title": "ParameterRegistry",
  "type": "object"
}